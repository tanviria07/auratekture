{
  "name": "Authorization",
  "type": "object",
  "properties": {
    "mandate_id": {
      "type": "string"
    },
    "store": {
      "type": "string"
    },
    "amount_cents": {
      "type": "number"
    },
    "mode": {
      "type": "string",
      "enum": [
        "sandbox",
        "simulated"
      ]
    },
    "status": {
      "type": "string"
    },
    "transaction_id": {
      "type": "string"
    },
    "response_summary": {
      "type": "string"
    },
    "verifier_steps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "ok": {
            "type": "boolean"
          },
          "detail": {
            "type": "string"
          }
        }
      }
    },
    "signed_request": {
      "type": "object",
      "properties": {
        "signature_input": {
          "type": "string"
        },
        "signature": {
          "type": "string"
        },
        "content_digest": {
          "type": "string"
        },
        "body": {
          "type": "string"
        },
        "created": {
          "type": "number"
        }
      }
    }
  },
  "required": [
    "mandate_id",
    "store",
    "amount_cents",
    "mode"
  ]
}