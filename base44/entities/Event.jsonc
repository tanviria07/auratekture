{
  "name": "Event",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "visitor_id": {
      "type": "string"
    },
    "room_purpose": {
      "type": "string"
    },
    "venue_name": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "width_ft": {
      "type": "number"
    },
    "depth_ft": {
      "type": "number"
    },
    "ceiling_ft": {
      "type": "number"
    },
    "headcount": {
      "type": "number"
    },
    "budget_cents": {
      "type": "number"
    },
    "deadline": {
      "type": "string",
      "format": "date"
    },
    "photo_url": {
      "type": "string"
    },
    "photo_analysis": {
      "type": "object",
      "additionalProperties": true
    },
    "color_palette": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "existing_items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "count": {
            "type": "number"
          },
          "confidence": {
            "type": "number"
          },
          "heat_source": {
            "type": "boolean"
          }
        }
      }
    },
    "venue_supplied": {
      "type": "object",
      "properties": {
        "options": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "other": {
          "type": "string"
        }
      }
    },
    "outlets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "x_ft": {
            "type": "number"
          },
          "z_ft": {
            "type": "number"
          },
          "circuit_id": {
            "type": "string"
          }
        }
      }
    },
    "exits": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "x_ft": {
            "type": "number"
          },
          "z_ft": {
            "type": "number"
          },
          "width_ft": {
            "type": "number"
          },
          "suggested": {
            "type": "boolean"
          }
        }
      }
    },
    "fixtures": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "x_ft": {
            "type": "number"
          },
          "z_ft": {
            "type": "number"
          },
          "suggested": {
            "type": "boolean"
          }
        }
      }
    },
    "kit_lines": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "products": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "products_at": {
      "type": "string",
      "format": "date-time"
    },
    "products_source": {
      "type": "string",
      "enum": [
        "live",
        "demo"
      ]
    },
    "demo_run": {
      "type": "object",
      "properties": {
        "kit_lines": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "products": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "products_at": {
          "type": "string",
          "format": "date-time"
        },
        "previews": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "basket": {
          "type": "object",
          "additionalProperties": true
        },
        "saved_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "prefetch": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "fingerprint": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "running",
            "ready",
            "failed"
          ]
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "all_kit_lines": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "kit_lines": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "theme": {
          "type": "string"
        },
        "all_products": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "products": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "product_choices": {
          "type": "object",
          "additionalProperties": true
        },
        "products_at": {
          "type": "string",
          "format": "date-time"
        },
        "timings": {
          "type": "object",
          "additionalProperties": true
        },
        "image": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "product_choices": {
      "type": "object",
      "additionalProperties": true
    },
    "previews": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "preview_url": {
            "type": "string"
          },
          "prompt": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "hotspots": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "choices": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "planning",
        "ready"
      ],
      "default": "draft"
    },
    "theme": {
      "type": "string"
    }
  },
  "required": [
    "name"
  ]
}